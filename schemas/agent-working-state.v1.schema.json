{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent working state v1",
  "type": "object",
  "required": [
    "schema_version",
    "last_updated",
    "current_goal",
    "current_status",
    "active_feature_ids",
    "done_latest",
    "next",
    "blockers",
    "validation_targets",
    "memory_tiers",
    "token_budget_policy",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-working-state.v1"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "current_goal": {
      "type": "string",
      "minLength": 1
    },
    "current_status": {
      "type": "string",
      "minLength": 1
    },
    "active_feature_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "done_latest": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "memory_tiers": {
      "type": "object",
      "required": [
        "hot",
        "snapshot",
        "state",
        "archive"
      ],
      "additionalProperties": false,
      "properties": {
        "hot": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "token_budget_policy": {
      "type": "object",
      "required": [
        "local_fast_path",
        "cross_module",
        "release_or_resume"
      ],
      "additionalProperties": false,
      "properties": {
        "local_fast_path": {
          "type": "string",
          "minLength": 1
        },
        "cross_module": {
          "type": "string",
          "minLength": 1
        },
        "release_or_resume": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
