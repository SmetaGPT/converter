{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmetaGPT/converter/schemas/document.v1.schema.json",
  "title": "Document V1",
  "type": "object",
  "required": ["schema_version", "document_id", "source", "processing", "metadata", "units", "assets", "quality"],
  "properties": {
    "schema_version": { "const": "document.v1" },
    "document_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "required": ["original_path", "filename", "format", "sha256", "size_bytes"],
      "properties": {
        "original_path": { "type": "string" },
        "relative_input_path": { "type": ["string", "null"] },
        "filename": { "type": "string" },
        "format": { "enum": ["docx", "pdf"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "processing": {
      "type": "object",
      "required": ["route", "status"],
      "properties": {
        "route": { "enum": ["docx_native", "pdf_text", "pdf_scan"] },
        "status": { "enum": ["success", "partial_success", "failed", "skipped_duplicate"] },
        "ocr_applied": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "metadata": {
      "$ref": "#/$defs/document_metadata"
    },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_unit" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "document_metadata": {
      "type": "object",
      "required": ["title", "document_type", "short_summary", "confidence", "method"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "document_type": { "type": "string", "minLength": 1 },
        "short_summary": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "method": { "enum": ["rule_based_title_extraction", "filename_fallback"] }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "flags": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["flags", "warnings"],
      "additionalProperties": false
    },
    "structural_unit": {
      "type": "object",
      "required": ["unit_id", "type", "order", "source_ref"],
      "properties": {
        "unit_id": { "type": "string", "pattern": "^u_[0-9]{6}$" },
        "parent_id": { "type": ["string", "null"] },
        "type": {
          "enum": [
            "document",
            "page",
            "section",
            "paragraph",
            "list",
            "list_item",
            "table",
            "table_row",
            "table_cell",
            "formula",
            "formula_image",
            "figure",
            "caption",
            "footnote",
            "header",
            "footer"
          ]
        },
        "order": { "type": "integer", "minimum": 0 },
        "text": { "type": ["string", "null"] },
        "asset_ref": { "type": ["string", "null"] },
        "source_ref": {
          "type": "object",
          "required": ["document_id"],
          "properties": {
            "document_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "page": { "type": ["integer", "null"], "minimum": 1 },
            "bbox": {
              "type": ["array", "null"],
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            },
            "docx_path": { "type": ["string", "null"] },
            "coordinate_system": { "type": ["string", "null"] },
            "page_width": { "type": ["number", "null"] },
            "page_height": { "type": ["number", "null"] }
          },
          "additionalProperties": false
        },
        "quality": { "$ref": "#/$defs/quality" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["asset_id", "type", "path"],
      "properties": {
        "asset_id": { "type": "string" },
        "type": { "enum": ["page_image", "figure", "formula_image", "ocr_pdf", "ocr_sidecar", "other"] },
        "path": { "type": "string" },
        "unit_id": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "filename": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "media_type": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}