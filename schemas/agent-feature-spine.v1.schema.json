{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent feature spine v1",
  "type": "object",
  "required": [
    "schema_version",
    "last_updated",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-feature-spine.v1"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "feature_id",
        "area",
        "title",
        "status",
        "behavior",
        "owner_docs",
        "verification",
        "evidence",
        "residual_risk"
      ],
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "backlog",
            "active",
            "validated"
          ]
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "owner_docs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verification_entry"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "residual_risk": {
          "type": "string"
        }
      }
    },
    "verification_entry": {
      "type": "object",
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "command",
            "procedure"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}