{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent weekly reviews v1",
  "type": "object",
  "required": [
    "schema_version",
    "last_updated",
    "reviews"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-weekly-reviews.v1"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "required": [
        "days",
        "start_date",
        "end_date"
      ],
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "scope_control",
        "feature_traceability",
        "hypothesis_quality",
        "validation_quality",
        "evidence_quality",
        "state_hygiene",
        "closeout_quality"
      ],
      "additionalProperties": false,
      "properties": {
        "scope_control": { "type": "integer", "minimum": 0, "maximum": 2 },
        "feature_traceability": { "type": "integer", "minimum": 0, "maximum": 2 },
        "hypothesis_quality": { "type": "integer", "minimum": 0, "maximum": 2 },
        "validation_quality": { "type": "integer", "minimum": 0, "maximum": 2 },
        "evidence_quality": { "type": "integer", "minimum": 0, "maximum": 2 },
        "state_hygiene": { "type": "integer", "minimum": 0, "maximum": 2 },
        "closeout_quality": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "sampled_task": {
      "type": "object",
      "required": [
        "task",
        "task_type",
        "feature_ids",
        "scores",
        "total_score",
        "max_score",
        "interpretation"
      ],
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "feature_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "total_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        },
        "max_score": {
          "const": 14
        },
        "interpretation": {
          "type": "string",
          "enum": [
            "weak closeout",
            "acceptable with gaps",
            "strong closeout"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "review_id",
        "review_date",
        "window",
        "summary",
        "sampled_tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "review_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sampled_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sampled_task"
          }
        }
      }
    }
  }
}