{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmetaGPT/converter/schemas/review-required.v1.schema.json",
  "title": "Review Required V1",
  "type": "object",
  "required": ["schema_version", "run_id", "relative_path", "status", "flags", "warnings"],
  "properties": {
    "schema_version": { "const": "review-required.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "relative_path": { "type": "string", "minLength": 1 },
    "status": { "enum": ["success", "partial_success", "failed", "skipped_duplicate", "cancelled"] },
    "document_id": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "output_dir": { "type": ["string", "null"] },
    "flags": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error_type": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}