{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmetaGPT/converter/schemas/ocr-runtime.v1.schema.json",
  "title": "OCR Runtime V1",
  "type": "object",
  "required": ["schema_version", "status", "tools", "languages", "warnings"],
  "properties": {
    "schema_version": { "const": "ocr-runtime.v1" },
    "status": { "enum": ["ready", "missing"] },
    "tools": {
      "type": "object",
      "required": ["ocrmypdf", "tesseract", "ghostscript"],
      "properties": {
        "ocrmypdf": { "$ref": "#/$defs/tool" },
        "tesseract": { "$ref": "#/$defs/tool" },
        "ghostscript": { "$ref": "#/$defs/tool" }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "required": ["requested", "installed", "missing"],
      "properties": {
        "requested": { "type": "array", "items": { "type": "string" } },
        "installed": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["available", "path"],
      "properties": {
        "available": { "type": "boolean" },
        "path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}