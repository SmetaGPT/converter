{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent telemetry entry v1",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "task",
    "task_type",
    "touched_areas",
    "feature_ids",
    "validation_targets",
    "validation_result",
    "state_update",
    "note"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-telemetry-entry.v1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "touched_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "validation_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_result": {
      "enum": [
        "passed",
        "passed_after_repair",
        "failed",
        "blocked"
      ]
    },
    "state_update": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}