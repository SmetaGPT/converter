{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmetaGPT/converter/schemas/chunk-source.v1.schema.json",
  "title": "Chunk Source V1",
  "type": "object",
  "required": ["chunk_id", "document_id", "unit_refs", "text"],
  "properties": {
    "chunk_id": { "type": "string" },
    "document_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "unit_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^u_[0-9]{6}$" },
      "minItems": 1
    },
    "section_path": { "type": "array", "items": { "type": "string" } },
    "pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "text": { "type": "string" },
    "asset_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}