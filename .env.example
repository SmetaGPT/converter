LLM_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
# Formula recognition mode:
# - fallback: only unresolved formulas go to providers.
# - mathpix_first: Mathpix reads formula images first, then LLM normalizes to calc_expr.
# - llm_first: low-confidence formulas may be reprocessed by LLM.
# - off: disable provider formula recognition.
# FORMULA_RECOGNITION_MODE=mathpix_first

# Optional Mathpix Convert API credentials for formula OCR.
# MATHPIX_APP_ID=paste-app-id-here
# MATHPIX_APP_KEY=paste-app-key-here

# Optional local formula OCR backend. Supported values: tesseract, paddleocr.
# `tesseract` uses the local Tesseract CLI. `paddleocr` requires separate
# PaddleOCR + PaddlePaddle installation in the Python environment.
# FORMULA_RECOGNITION_LOCAL_BACKEND=tesseract
# Optional formula override. If omitted and OPENROUTER_API_KEY is set,
# formula recognition defaults to openai/gpt-4o.
# With Mathpix enabled, openai/gpt-4o-mini is usually the first cost/quality candidate
# for normalization because Mathpix already handles the visual OCR step.
# FORMULA_MODEL=openai/gpt-4o
OPENROUTER_API_KEY=paste-api-key-here