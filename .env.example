LLM_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
# Optional local formula OCR backend. Safe current value: tesseract.
# FORMULA_RECOGNITION_LOCAL_BACKEND=tesseract
# Optional formula override. If omitted and OPENROUTER_API_KEY is set,
# formula recognition defaults to openai/gpt-4o.
# FORMULA_MODEL=openai/gpt-4o
OPENROUTER_API_KEY=paste-api-key-here